rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Community fraud broadcasts: readable by all agents, writeable for scam reports
    match /fraud_broadcasts/{alertId} {
      allow read, create: if true;
      allow update, delete: if request.auth != null;
    }

    match /{document=**} {
      // 100% Locked Down: All operations go through Cloud Functions.
      // Cloud Functions use the Admin SDK, which bypasses these rules entirely.
      allow read, write: if false;
    }
  }
}
